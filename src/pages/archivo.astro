---
import { isOff } from '@fediblog/core/lib/flags';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getNotas, getTags } from '@fediblog/core/lib/notas';
import { SITE } from '../config';

if (isOff(SITE.archive?.show)) return Astro.redirect(import.meta.env.BASE_URL);

const notas = await getNotas();
const tags = await getTags();
const base = import.meta.env.BASE_URL;
---

<Base title="Archivo" description={`Archivo de entradas de ${SITE.site.title}.`} isEntry>
  <header class="archive-header">
    <h1 class="archive-title">Archivo</h1>
    <p class="archive-count">{notas.length} {notas.length === 1 ? 'entrada' : 'entradas'} en total.</p>
  </header>

  {tags.length > 0 && (
    <nav class="archive-tags" aria-label="Etiquetas del archivo">
      <ul class="tags-list">
        {tags.map((tag) => (
          <li>
            <a href={`${base}etiquetas/${tag.slug}/`} class="tag-link">
              <span class="tag-hash" aria-hidden="true">#</span>
              <span>{tag.name}</span>
              <span class="tag-count" aria-label={`(${tag.count} entradas)`}>{tag.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <EntryList notas={notas} showAllYears alwaysShowDates />

  {notas.length === 0 && <p class="empty">Todavía no hay publicaciones.</p>}
</Base>

<style>
  .archive-header {
    margin-bottom: 2rem;
  }

  .archive-title {
    font-family: var(--text-font);
    font-size: var(--font-size-entry-h1, 1.35rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0 0 0.35rem;
    color: var(--fg);
    transition: font-size 0.2s ease;
  }

  .archive-count {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--muted);
    margin: 0;
  }

  .archive-tags {
    margin: 0 0 2.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .tags-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--muted);
    background: var(--surface);
    padding: 0.22rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .tag-link:hover {
    background: var(--surface-hover);
    color: var(--fg);
    text-decoration: none;
  }

  .tag-hash {
    opacity: 0.45;
  }

  .tag-count {
    font-size: 0.68rem;
    opacity: 0.6;
    margin-left: 0.1rem;
  }

  @media (pointer: coarse) {
    .tag-link {
      padding: 0.4rem 0.75rem;
      min-height: 2.25rem;
    }
  }

  .empty {
    color: var(--muted);
    padding: 2rem 0;
  }
</style>
