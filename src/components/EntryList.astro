---
import type { Nota } from '@fediblog/core/lib/notas';
import { formatDate } from '@fediblog/core/lib/format';

interface Props {
  notas: Nota[];
  showAllYears?: boolean;
  alwaysShowDates?: boolean;
}

const { notas, showAllYears = false, alwaysShowDates = false } = Astro.props;
const base = import.meta.env.BASE_URL;


// Las notas llegan de más nueva a más antigua: se agrupan por año respetando el orden.
const years: { year: number; items: Nota[] }[] = [];
for (const nota of notas) {
  const year = nota.data.date.getUTCFullYear();
  const last = years[years.length - 1];
  if (last && last.year === year) last.items.push(nota);
  else years.push({ year, items: [nota] });
}
---

{
  years.map(({ year, items }, index) => (
    <section class="year" aria-label={String(year)}>
      {(showAllYears || index > 0) && <h2 class="year-label">{year}</h2>}
      <ul class:list={['entries', alwaysShowDates && 'show-dates']}>
        {items.map((nota) => (
          <li class="entry-item">
            <a href={`${base}${nota.id}/`} class="entry-link">
              <span class="entry-title">{nota.data.title}</span>
              <time class="entry-date" datetime={nota.data.date.toISOString()} title={formatDate(nota.data.date, 'dd/mm/yyyy')}>
                <span class="sr-only">Publicado el {formatDate(nota.data.date, 'dd/mm/yyyy')}: </span>
                <span aria-hidden="true">{formatDate(nota.data.date, 'dd/mm')}</span>
              </time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  .year + .year {
    margin-top: 2rem;
  }

  .year-label {
    margin: 0 0 0.5rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry-item {
    margin: 0;
  }

  .entry-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.32rem 0.45rem;
    margin: 0 -0.45rem;
    border-radius: 4px;
    text-decoration: none;
    color: var(--fg);
    transition: background-color 0.1s ease;
  }

  .entry-link:hover,
  .entry-link:focus-visible {
    background-color: var(--surface);
  }

  .entry-title {
    font-family: var(--text-font);
    font-size: var(--font-size-entry-title, 0.88rem);
    line-height: 1.45;
    font-weight: normal;
    color: var(--fg);
    text-wrap: pretty;
    overflow-wrap: anywhere;
    flex: 1;
    min-width: 0;
    transition: font-size 0.2s ease;
  }

  .entry-date {
    font-family: var(--mono);
    font-size: var(--font-size-meta, 0.74rem);
    color: var(--muted);
    white-space: nowrap;
    letter-spacing: 0.01em;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.12s ease, color 0.12s ease, font-size 0.2s ease;
  }

  .entries.show-dates .entry-date {
    opacity: 0.8;
  }

  .entry-link:hover .entry-date,
  .entry-link:focus .entry-date,
  .entry-link:focus-visible .entry-date {
    opacity: 1;
    color: var(--fg);
  }

  @media (hover: none) {
    .entry-date {
      opacity: 0.75;
    }
  }

  .entry-link:focus-visible {
    outline: 2px solid var(--accent-1);
    outline-offset: 1px;
  }

  @media (pointer: coarse) {
    .entry-link {
      padding: 0.55rem 0.45rem;
      min-height: 2.75rem;
    }
  }

  @media (max-width: 38rem) {
    .entry-link {
      padding: 0.45rem 0.25rem;
      margin: 0 -0.25rem;
      gap: 0.75rem;
    }
  }
</style>
